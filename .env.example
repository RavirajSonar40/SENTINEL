# ============================================
# Sentinel — Environment Configuration
# ============================================
# Copy this file to .env and fill in your values

# --- Database ---
DATABASE_URL=postgresql+psycopg://sentinel:sentinel_dev_2026@localhost:5432/sentinel
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=sentinel_dev_2026
POSTGRES_DB=sentinel

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Qdrant ---
QDRANT_URL=http://localhost:6333

# --- Auth ---
SECRET_KEY=change-me-to-a-random-string-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- LLM Provider ---
# Options: nemotron, openai, anthropic, kimi, ollama, mock
# For local dev / testing, use: mock
# For production, set provider to nemotron and configure credentials:
LLM_PROVIDER=mock
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_API_KEY=
# LLM_MODEL is provider-dependent. Configure the exact model ID supported by your endpoint:
# Examples:
#   NVIDIA NIM: nvidia/nemotron-4-340b-instruct or meta/llama-3.3-70b-instruct
#   OpenAI: gpt-4o-mini or gpt-4o
#   Anthropic: claude-3-5-sonnet-20241022
#   Ollama: llama3.2
LLM_MODEL=
LLM_TEMPERATURE=0.3
LLM_TIMEOUT_SECONDS=60
LLM_MAX_OUTPUT_TOKENS=4000
LLM_MAX_REQUEST_RETRIES=2
LLM_JSON_REPAIR_RETRIES=1
LLM_CACHE_ENABLED=true
LLM_CACHE_TTL_SECONDS=300

# --- Embeddings ---
# Options: local, openai, huggingface
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSIONS=384
EMBEDDING_API_KEY=
EMBEDDING_API_URL=

# --- GitHub Integration ---
# Create a GitHub App at https://github.com/settings/apps
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=
GITHUB_APP_URL=

# --- Frontend ---
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- CORS ---
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Logging ---
LOG_LEVEL=INFO
