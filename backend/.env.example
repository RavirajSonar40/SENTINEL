# =============================================================================
# Sentinel Backend Environment Variables (Phase 1 AI & Services)
# =============================================================================

# Database
DATABASE_URL=postgresql://sentinel:sentinel_dev_2026@localhost:5432/sentinel
ENVIRONMENT=development

# Authentication
SECRET_KEY=change-me-to-a-random-string-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# LLM Provider Configuration
# Options: nemotron, openai, anthropic, kimi, ollama, mock
# For local dev / testing: mock
# For production: set to nemotron and provide URL, KEY, MODEL
LLM_PROVIDER=mock
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_API_KEY=
# LLM_MODEL is provider-dependent. Configure the exact model ID supported by your endpoint:
# Examples:
#   NVIDIA NIM: nvidia/nemotron-4-340b-instruct or meta/llama-3.3-70b-instruct
#   OpenAI: gpt-4o-mini or gpt-4o
#   Anthropic: claude-3-5-sonnet-20241022
#   Ollama: llama3.2
LLM_MODEL=
LLM_TEMPERATURE=0.3
LLM_TIMEOUT_SECONDS=60
LLM_MAX_OUTPUT_TOKENS=4000
LLM_MAX_REQUEST_RETRIES=2
LLM_JSON_REPAIR_RETRIES=1
LLM_CACHE_ENABLED=true
LLM_CACHE_TTL_SECONDS=300

# Redis & Vector Store
REDIS_URL=redis://localhost:6379/0
PINECONE_API_KEY=
PINECONE_INDEX=sentinel

# GitHub Integration
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=
GITHUB_TOKEN=

# Service URL
FRONTEND_URL=http://localhost:3000
LOG_LEVEL=INFO
